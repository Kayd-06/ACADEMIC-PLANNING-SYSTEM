AUTH_SECRET=your_next_auth_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
MANAGEMENT_INVITE_CODE=your_invite_code

# PostgreSQL (Neon) — the app's only database
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
# Required only for database-backed Jest tests. Never point this at production.
TEST_DATABASE_URL=postgresql://<username>:<password>@<test-host>:5432/<test-database>

# Bearer token Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` — required by /api/cron/class-promotion
CRON_SECRET=your_cron_secret_here
